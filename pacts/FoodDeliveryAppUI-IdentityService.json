{
  "consumer": {
    "name": "FoodDeliveryAppUI"
  },
  "interactions": [
    {
      "description": "a request to initiate login",
      "request": {
        "body": {
          "phoneNumber": "1234567890",
          "serviceName": "CUSTOMER"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/internal/auth/initiate"
      },
      "response": {
        "body": {
          "message": "OTP sent successfully",
          "success": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.success": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.1"
    },
    "pactRust": {
      "ffi": "0.5.6",
      "models": "1.3.14"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "IdentityService"
  }
}