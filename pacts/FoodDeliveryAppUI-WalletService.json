{
  "consumer": {
    "name": "FoodDeliveryAppUI"
  },
  "interactions": [
    {
      "description": "a request to get wallet balance",
      "request": {
        "headers": {
          "Authorization": "Bearer VALID_TOKEN"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/v1/wallets/balance"
      },
      "response": {
        "body": {
          "data": {
            "balance": 1000.5,
            "currency": "INR",
            "walletId": "123e4567-e89b-12d3-a456-426614174000"
          },
          "message": "Balance retrieved successfully",
          "success": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data.balance": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.data.currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.walletId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.success": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.1"
    },
    "pactRust": {
      "ffi": "0.5.6",
      "models": "1.3.14"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "WalletService"
  }
}