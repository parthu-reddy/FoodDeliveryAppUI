{
  "consumer": {
    "name": "FoodDeliveryAppUI"
  },
  "interactions": [
    {
      "description": "a request to get a wallet by entity",
      "request": {
        "headers": {
          "X-User-Id": "123e4567-e89b-12d3-a456-426614174000"
        },
        "matchingRules": {
          "header": {
            "X-User-Id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/v1/wallets/CUSTOMER/123e4567-e89b-12d3-a456-426614174000"
      },
      "response": {
        "body": {
          "balance": 1000.5,
          "currency": "INR",
          "entityId": "123e4567-e89b-12d3-a456-426614174000",
          "entityType": "CUSTOMER",
          "id": "7a1d5e90-3c22-4b6f-8a11-9d4c2e77b501",
          "status": "ACTIVE"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.balance": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.entityId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.entityType": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.1"
    },
    "pactRust": {
      "ffi": "0.5.6",
      "models": "1.3.14"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "WalletService"
  }
}